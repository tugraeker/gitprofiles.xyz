{
  "name": "gitprofiles-xyz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive developer micro-profile studio built with React, Electron, and an optional Rust core.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm run test && vite build",
    "build:web": "npm run typecheck && npm run test && vite build --base=/",
    "vercel-build": "npm run build:web",
    "native:build": "napi build --manifest-path native/Cargo.toml --platform --release --output-dir native",
    "desktop:dir": "npm run build && electron-builder --dir",
    "dist": "npm run native:build && npm run build && electron-builder"
  },
  "build": {
    "appId": "xyz.gitprofiles.studio",
    "productName": "gitprofiles.xyz",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "native/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "gitprofiles",
        "schemes": ["gitprofiles"]
      }
    ],
    "asarUnpack": [
      "native/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "napi": {
    "binaryName": "gitprofiles_native",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
